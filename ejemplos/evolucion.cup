# Evoluciones: cada Pokémon evoluciona al llegar a cierto nivel

evoluciones = [
    "Charmander": (en: "Charmeleon", nivel: 16),
    "Charmeleon": (en: "Charizard", nivel: 36),
    "Bulbasaur":  (en: "Ivysaur", nivel: 16),
    "Squirtle":   (en: "Wartortle", nivel: 16),
]

fx entrenar(nombre, desde, hasta):
    actual = nombre
    for nivel in desde..hasta:
        evo = evoluciones[actual] else none
        if evo is not none and nivel == evo.nivel:
            show("  Nivel {nivel}: ¡{actual} evolucionó a {evo.en}!")
            actual = evo.en
    return actual

for inicial in ["Charmander", "Bulbasaur", "Pikachu"]:
    show("{inicial} entrena del nivel 5 al 40:")
    final = entrenar(inicial, 5, 40)
    if final == inicial:
        show("  {inicial} no evolucionó (necesita una piedra trueno)")
    show("  Al final es {final}")
