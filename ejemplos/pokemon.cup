# Funciones para trabajar con Pokémon.
# Otros archivos las usan con:  use describir, curar from pokemon

fx pokemon(nombre, tipo, vida = 35):
    return (nombre: nombre, tipo: tipo, vida: vida)

fx describir(p):
    return "{p.nombre} ({p.tipo}): {p.vida} de vida"

fx curar(p, cantidad):
    assert cantidad > 0
    p.vida = min(p.vida + cantidad, 40)
    return p
