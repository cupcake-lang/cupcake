# Entrenamiento: gana experiencia y sube de nivel

fx experiencia_para(nivel):
    return nivel * nivel * 10

pika = (nombre: "Pikachu", nivel: 5, experiencia: 0)
combates = [120, 300, 450, 80, 600, 900]

for i, ganada at combates:
    pika.experiencia += ganada
    show("Combate {i + 1}: +{ganada} de experiencia")
    while pika.experiencia >= experiencia_para(pika.nivel):
        pika.experiencia -= experiencia_para(pika.nivel)
        pika.nivel += 1
        show("  ¡{pika.nombre} subió al nivel {pika.nivel}!")

show("Final: {pika.nombre}, nivel {pika.nivel}, con {pika.experiencia} puntos de experiencia")
