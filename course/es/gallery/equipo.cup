# Un pequeño equipo Pokémon en Cupcake

use pokemon, describir, curar from pokemon

equipo = [
    pokemon("Pikachu", "eléctrico", vida = 12),
    pokemon("Charmander", "fuego", vida = 39),
    pokemon("Squirtle", "agua", vida = 0),
]

# Los que pueden pelear, curados
vivos = [p for p in equipo if p.vida > 0]
vivos = [curar(p, 20) for p in vivos]

show("Listos para pelear:")
for p in sorted(vivos, fx: it.nombre):
    show("  " + describir(p))

# Los que necesitan ayuda
for p in equipo:
    if p.vida == 0:
        show("{p.nombre} necesita ir al Centro Pokémon")
    else if p.vida < 20:
        show("{p.nombre} estaba débil")

# Un diccionario con los precios de la tienda
precios = ["pokeball": 200, "pocion": 300, "superball": 600]
total = sum([precios[cosa] for cosa in ["pokeball", "pocion"]])
show("Una Poké Ball y una Poción cuestan {total}")
