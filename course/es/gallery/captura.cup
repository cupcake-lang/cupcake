# Atrapar un Pokémon salvaje: tienes tres Poké Balls

salvaje = pick(["Pidgey", "Rattata", "Caterpie", "Pikachu", "Abra", "Eevee"])
when salvaje:
    in ["Pikachu", "Abra", "Eevee"]:
        dificultad = 30
    else:
        dificultad = 60
show("¡Un {salvaje} salvaje apareció!")

atrapado = false
for intento in 1..3:
    show("Lanzas la Poké Ball número {intento}…")
    if roll(1, 100) <= dificultad:
        atrapado = true
        break
    show("  ¡Se escapó!")

if atrapado:
    show("¡Atrapaste a {salvaje}!")
else:
    show("{salvaje} huyó. ¡Será la próxima!")
