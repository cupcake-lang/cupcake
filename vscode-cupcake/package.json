{
  "name": "cupcake",
  "displayName": "Cupcake",
  "description": "Cupcake 1.0 \"Frambuesa\": colors, indentation and snippets for .cup files",
  "version": "1.0.0",
  "publisher": "jesus-local",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cupcake",
        "aliases": [
          "Cupcake",
          "cupcake"
        ],
        "extensions": [
          ".cup"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./file-icon.svg",
          "dark": "./file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "cupcake",
        "scopeName": "source.cupcake",
        "path": "./syntaxes/cupcake.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cupcake",
        "path": "./snippets/cupcake.json"
      }
    ],
    "configurationDefaults": {
      "[cupcake]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    }
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cupcake-lang/cupcake"
  },
  "license": "MIT"
}