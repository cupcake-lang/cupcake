{
  "Anonymous function with λ": {
    "prefix": "lam",
    "body": "λ(${1:p}): $0",
    "description": "Type lam and press Tab to get the λ symbol"
  },
  "Function": {
    "prefix": "fx",
    "body": [
      "fx ${1:name}(${2}):",
      "\treturn $0"
    ],
    "description": "A named function"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "fx main():",
      "\t$0"
    ],
    "description": "What runs when you run this file"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "\t$0"
    ]
  },
  "If, else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}:",
      "\t$2",
      "else:",
      "\t$0"
    ]
  },
  "When": {
    "prefix": "when",
    "body": [
      "when ${1:value}:",
      "\tis ${2:\"something\"}:",
      "\t\t$3",
      "\telse:",
      "\t\t$0"
    ]
  },
  "Repeat": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3}:",
      "\t$0"
    ]
  },
  "For each": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:list}:",
      "\t$0"
    ]
  },
  "For each position": {
    "prefix": "forat",
    "body": [
      "for ${1:i}, ${2:x} at ${3:list}:",
      "\t$0"
    ]
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "\t$0"
    ]
  },
  "Try": {
    "prefix": "try",
    "body": [
      "try:",
      "\t$1",
      "except ${2:error}:",
      "\t$0"
    ]
  }
}