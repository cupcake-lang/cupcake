{
  "Función anónima con λ": {
    "prefix": "lam",
    "body": "λ(${1:p}): $0",
    "description": "Escribe lam y pulsa Tab para usar el símbolo λ"
  },
  "Función": {
    "prefix": "fx",
    "body": [
      "fx ${1:nombre}(${2}):",
      "\treturn $0"
    ],
    "description": "Una función con nombre"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "fx main():",
      "\t$0"
    ],
    "description": "Lo que corre al ejecutar este archivo"
  },
  "Si": {
    "prefix": "if",
    "body": [
      "if ${1:condición}:",
      "\t$0"
    ]
  },
  "Si, si no": {
    "prefix": "ife",
    "body": [
      "if ${1:condición}:",
      "\t$2",
      "else:",
      "\t$0"
    ]
  },
  "Cuando": {
    "prefix": "when",
    "body": [
      "when ${1:valor}:",
      "\tis ${2:\"algo\"}:",
      "\t\t$3",
      "\telse:",
      "\t\t$0"
    ]
  },
  "Repetir": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3}:",
      "\t$0"
    ]
  },
  "Por cada uno": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:lista}:",
      "\t$0"
    ]
  },
  "Por cada posición": {
    "prefix": "forat",
    "body": [
      "for ${1:i}, ${2:x} at ${3:lista}:",
      "\t$0"
    ]
  },
  "Mientras": {
    "prefix": "while",
    "body": [
      "while ${1:condición}:",
      "\t$0"
    ]
  },
  "Intentar": {
    "prefix": "try",
    "body": [
      "try:",
      "\t$1",
      "except ${2:error}:",
      "\t$0"
    ]
  }
}